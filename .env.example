# ─────────────────────────────────────────────────────────────
# NEXUS ARENA — Environment Configuration
# Copy this file to `.env.local` and fill in real values.
# NEVER commit real secrets to version control.
#
# LOCAL DEV: everything is OPTIONAL — `npm run dev` works with no
# env file at all (auto in-memory database + dev auth secret).
# VERCEL/PRODUCTION: MONGODB_URI and AUTH_SECRET are required.
# Full step-by-step key guide: README.md → Part 2.
# ─────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────
# MongoDB connection string (MongoDB Atlas or self-hosted).
# Leave unset (or set to `memory`) for an auto-managed in-memory
# database in local development — data resets on restart.
MONGODB_URI=memory

# Secret used to sign session JWTs (min 32 chars). Generate with: openssl rand -base64 48
# (Windows PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 64 | % {[char]$_}))
AUTH_SECRET=change-me-to-a-long-random-string-min-32-chars

# Public base URL of the deployment (used for OAuth redirects / emails).
# Keep this equal to the exact host/port you registered in Google Cloud.
# If you use another local port, update this value or remove it to use the request host.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Google OAuth ─────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Razorpay (India payments: UPI, Cards, Netbanking, Wallets) ─
# https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → secret (used to verify webhook signatures)
RAZORPAY_WEBHOOK_SECRET=

# ── AI (OpenAI-compatible API, e.g. api.openai.com) ──────────
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ── Transactional Email (Resend-compatible HTTP API) ─────────
EMAIL_API_KEY=
# Test sender: Resend permits delivery only to the address on your Resend account.
# For other recipients, verify your own domain in Resend and use its sender address.
EMAIL_FROM="NEXUS ARENA <onboarding@resend.dev>"

# ── Optional tuning ──────────────────────────────────────────
# Force-disable payments (e.g. tournaments hosted for free in dev)
# PAYMENTS_DISABLED=false
